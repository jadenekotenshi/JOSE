{
  Contexts = (
    {
      Keywords = (
        {
          Pattern = "@[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*";
          ForegroundColor = "0.8 0 0";
          Bold = YES;
        },
        {
          Pattern = "\\.[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "#[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*";
          ForegroundColor = "0.1 0.3 0.8";
        },
        {
          Pattern = "::?[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*";
          ForegroundColor = "0.2 0.3 0.8";
        }
      );
    },

    {
      Beginning = "/\\*";
      Ending = "\\*/";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    /* a declaration block */
    {
      Beginning = "\\{";
      Ending = "\\}";
      ForegroundColor = "0.15 0.15 0.15";
      Keywords = (
        {
          Pattern = "<[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*[ ]*:";
          ForegroundColor = "0.2 0.3 0.8";
        },
        {
          Pattern = "<[0123456789][0123456789.]*[abcdefghijklmnopqrstuvwxyz%]*";
          ForegroundColor = "0.8 0.4 0";
        },
        {
          Pattern = "#[0123456789abcdefABCDEF]{3,8}";
          ForegroundColor = "0.8 0.4 0";
        },
        {
          Pattern = "!important";
          ForegroundColor = "0.8 0 0";
          Bold = YES;
        }
      );
    },

    {
      Beginning = "\"";
      Ending = "[\"\n]";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\\""
      );
      ForegroundColor = "0 0.7 0";
    },

    {
      Beginning = "'";
      Ending = "['\n]";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\'"
      );
      ForegroundColor = "0 0.7 0";
    },

    {
      Parent = 2;
      Beginning = "/\\*";
      Ending = "\\*/";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Parent = 2;
      Beginning = "\"";
      Ending = "[\"\n]";
