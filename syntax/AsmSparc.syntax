      );
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    /* cpp line */
    {
      Beginning = "^#[ ]*<line>";
      Ending = "\n";
      ContextSkips = (
        "\\\\\n"
      );
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    {
      Beginning = "/\\*";
      Ending = "\\*/";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "!";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    /* # at the start of a line */
    {
      Beginning = "^#";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "\"";
      Ending = "[\"\n]";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\\""
      );
      ForegroundColor = "0 0.7 0";
    }
  );
