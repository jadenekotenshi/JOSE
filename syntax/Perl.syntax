    },

    {
      Beginning = "^=[a-z]";
      Ending = "^=cut";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "\"";
      Ending = "\"";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\\""
      );
      ForegroundColor = "0 0.7 0";
    },

    {
      Beginning = "'";
      Ending = "'";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\'"
      );
      ForegroundColor = "0 0.7 0";
    },

    {
      Beginning = "#";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    }
