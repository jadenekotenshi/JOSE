/*
 * Highlighting rules for Imakefile and Imake templates (cpp lines, XCOMM comments, make rules).
 * Generated by tools/gen_syntax.py: change that, not this.
 */
{
  Contexts = (
    {
      Keywords = (
        {
          Pattern = "<AllTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<NormalProgramTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<NormalLibraryTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<NormalSharedLibraryTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<NormalLintTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallProgram>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallManPage>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallMultiple>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallNonExecFile>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallLibrary>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallScript>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallAppDefaults>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<DependTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<CleanTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<SubdirTarget>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<MakeSubdirs>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<MakeMakeSubdirs>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<DependSubdirs>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<InstallSubdirs>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<LinkSourceFile>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<ObjectCompile>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<CCsource>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<SRCS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<OBJS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<HEADERS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<LOCAL_LIBRARIES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<SYS_LIBRARIES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<DEPLIBS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<EXTRA_LIBRARIES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<EXTRA_INCLUDES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<EXTRA_DEFINES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<DEFINES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<INCLUDES>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<LDOPTIONS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<SUBDIRS>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<XCOMM>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "<NullParameter>";
          ForegroundColor = "0.2 0.3 0.8";
          Bold = YES;
        },
        {
          Pattern = "\\$[@<*%?]";
          ForegroundColor = "0.1 0.3 0.8";
          Bold = YES;
        }
      );
    },

    {
      Beginning = "\"";
      Ending = "\"";
      ForegroundColor = "0 0.7 0";
    },

    /* $(VAR) */
    {
      Beginning = "\\$\\(";
      Ending = "\\)";
      ForegroundColor = "0.1 0.3 0.8";
      Bold = YES;
    },

    /* ${VAR} */
    {
      Beginning = "\\$\\{";
      Ending = "\\}";
      ForegroundColor = "0.1 0.3 0.8";
      Bold = YES;
    },

    /* cpp line */
    {
      Beginning = "^#";
      Ending = "\n";
      ContextSkips = (
        "\\\\\n"
      );
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    /* XCOMM: a comment that cpp leaves in the Makefile */
    {
      Beginning = "^XCOMM";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "/\\*";
      Ending = "\\*/";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    /* <header> in a cpp line */
    {
      Parent = 4;
      Beginning = "\\<[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_./0123456789]";
      Ending = "\\>";
      ForegroundColor = "0.55 0.2 0.55";
    },

    /* "header" in a cpp line */
    {
      Parent = 4;
      Beginning = "\"";
      Ending = "\"";
      ForegroundColor = "0.55 0.2 0.55";
    }
  );
}
