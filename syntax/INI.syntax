/*
 * Highlighting rules for INI files (sections, keys, ; and # comments).
 * Generated by tools/gen_syntax.py: change that, not this.
 */
{
  Contexts = (
    {
      Keywords = (
        {
          Pattern = "^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-]*";
          ForegroundColor = "0.2 0.3 0.8";
        },
        {
          Pattern = "<0x[0123456789abcdefABCDEF]*>";
          ForegroundColor = "0.8 0.4 0";
        },
        {
          Pattern = "<[0-9][0-9]*>";
          ForegroundColor = "0.8 0.4 0";
        },
        {
          Pattern = "<true>";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "<false>";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "<yes>";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "<no>";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "<on>";
          ForegroundColor = "0.6 0.45 0.75";
        },
        {
          Pattern = "<off>";
          ForegroundColor = "0.6 0.45 0.75";
        }
      );
    },

    /* [section] */
    {
      Beginning = "^\\[";
      Ending = "\n";
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    {
      Beginning = "^;";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "^#";
      Ending = "\n";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    {
      Beginning = "\"";
      Ending = "[\"\n]";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\\""
      );
      ForegroundColor = "0 0.7 0";
    }
  );
}
