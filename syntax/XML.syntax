/*
 * Highlighting rules for XML.
 * Generated by tools/gen_syntax.py: change that, not this.
 */
{
  Contexts = (
    {
      Keywords = (
        {
          Pattern = "&[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_#][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_#]*;";
          ForegroundColor = "0.8 0.4 0";
        }
      );
    },

    {
      Beginning = "\\<!--";
      Ending = "--\\>";
      ForegroundColor = "0 0.5 0";
      Italic = YES;
    },

    /* CDATA */
    {
      Beginning = "\\<!\\[CDATA\\[";
      Ending = "\\]\\]\\>";
      ForegroundColor = "0.4 0.4 0.4";
    },

    /* processing instruction */
    {
      Beginning = "\\<\\?";
      Ending = "\\?\\>";
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    /* <!DOCTYPE ...> */
    {
      Beginning = "\\<!";
      Ending = "\\>";
      ForegroundColor = "0.8 0 0";
      Bold = YES;
    },

    /* a tag */
    {
      Beginning = "\\<[/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_:]";
      Ending = "\\>";
      ForegroundColor = "0.2 0.3 0.8";
      Bold = YES;
      Keywords = (
        {
          Pattern = "[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-:.][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-:.]*=";
          ForegroundColor = "0.1 0.3 0.8";
        }
      );
    },

    {
      Parent = 5;
      Beginning = "\"";
      Ending = "\"";
      ForegroundColor = "0 0.7 0";
    },

    {
      Parent = 5;
      Beginning = "'";
      Ending = "'";
      ForegroundColor = "0 0.7 0";
    }
  );
}
