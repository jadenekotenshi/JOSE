/*
 * Highlighting rules for JSON.
 * Generated by tools/gen_syntax.py: change that, not this.
 */
{
  Contexts = (
    {
      Keywords = (
        {
          Pattern = "<true>";
          ForegroundColor = "0.6 0.45 0.75";
          Bold = YES;
        },
        {
          Pattern = "<false>";
          ForegroundColor = "0.6 0.45 0.75";
          Bold = YES;
        },
        {
          Pattern = "<null>";
          ForegroundColor = "0.6 0.45 0.75";
          Bold = YES;
        },
        {
          Pattern = "<0x[0-9A-Fa-f]*>";
          ForegroundColor = "0.8 0.4 0";
        },
        {
          Pattern = "<[0-9][0-9]*>";
          ForegroundColor = "0.8 0.4 0";
        }
      );
    },

    {
      Beginning = "\"";
      Ending = "\"";
      ContextSkips = (
        "\\\\\\\\",
        "\\\\\""
      );
      ForegroundColor = "0 0.7 0";
    }
  );
}
